# 复制为 .env 后填写本地值：cp .env.example .env

# AI 视频总结
AI_API_KEY=
AI_API_BASE_URL=https://api.commandcode.ai/provider/v1
AI_MODEL=deepseek/deepseek-v4-flash
# 思考模式：off=关闭 | low/medium/high/xhigh/max | on=模型默认
AI_REASONING=off

# 可选：yt-dlp 从浏览器导入 Cookie
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES=/path/to/cookies.txt
